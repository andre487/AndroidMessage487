      "id": "2fba2d67-8054-5b2e-9b0d-e986f7842696",
      "name": "Validate event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const processImages = true;\nconst event = $('Webhook').first().json.body;\nlet reason = '';\nif (!event || event.schema_version !== 1 || typeof event.event_id !== 'string' ||\n    !event.event_id || !['test', 'notification', 'sms'].includes(event.message_type) ||\n    typeof event.text !== 'string') reason = 'Invalid Message487 event';\nconst images = event?.images ?? [];\nif (!Array.isArray(images)) reason = 'images must be an array';\nelse if (processImages && images.some(image => !image || !['image/jpeg', 'image/png'].includes(image.mime_type) ||\n    !Number.isInteger(image.width) || image.width <= 0 || !Number.isInteger(image.height) || image.height <= 0 ||\n    typeof image.data_base64 !== 'string' || !image.data_base64.length ||\n    image.data_base64.length % 4 !== 0 || !/^[A-Za-z0-9+/]*={0,2}$/.test(image.data_base64))) {\n  reason = 'Invalid JPEG/PNG image';\n}\nreturn [{ json: { valid: !reason, reason, event_id: event?.event_id ?? null } }];\n"
      }
    },
    {
      "id": "c57e4445-4585-5ae7-81b2-5a21aff9039a",
      "name": "Valid event",
      "type": "n8n-nodes-base.if",
