    {
      "id": "2379636e-be7e-5c90-8784-4fa4e92f3709",
      "name": "Read images",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ],
      "parameters": {
        "jsCode": "// The previous validation node checks image metadata and Base64 before this step.\nconst event = $('Webhook').first().json.body;\nconst binary = {};\nconst images = (event.images ?? []).map((image, index) => {\n  const { data_base64, ...metadata } = image;\n  binary[`image${index}`] = { data: data_base64, mimeType: image.mime_type,\n    fileName: `${['avatar', 'app_icon'].includes(image.kind) ? image.kind : 'attachment'}-${index + 1}.${image.mime_type === 'image/png' ? 'png' : 'jpg'}` };\n  return metadata;\n});\nreturn [{ json: { ...event, images, image_count: images.length }, binary }];\n"
      }
    },
    {
      "id": "87c32929-f9c2-5d03-8d5c-47037a71ed3a",
      "name": "Respond",
