{
  "name": "Message487 · 05 · Optional sent-key cleanup",
  "active": false,
  "nodes": [
    {
      "id": "aae74778-23a6-5b95-b951-bf05e33e867b",
      "name": "Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        400,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "8c1e16ff-1032-5f3a-8428-1606e9b7c2c4",
      "name": "Configure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        640,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fd0cda76-b600-5cbd-9182-6ffc99514f16",
              "name": "sent_parts_table_id",
              "value": "REPLACE_WITH_SENT_PARTS_TABLE_ID",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "83ed3b9b-0b03-5130-8ae7-e01bde5bf1a6",
      "name": "Delete old keys",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "deleteRows",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Configure').first().json.sent_parts_table_id }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "createdAt",
              "condition": "lt",
              "keyValue": "={{ $now.minus({ days: 30 }).toISO() }}"
            }
          ]
        },
        "options": {
          "dryRun": true
        }
      }
    }
  ],
  "connections": {
    "Daily": {
      "main": [
        [
          {
            "node": "Configure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configure": {
      "main": [
        [
          {
            "node": "Delete old keys",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  }
}
