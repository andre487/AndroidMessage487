    {
      "id": "b7380935-2c78-5cd7-8e53-08475221b95b",
      "name": "Prepare Telegram text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        0
      ],
      "parameters": {
        "jsCode": "const timeZone = 'UTC';\nconst locale = 'en-GB';\nconst messageTypes = { sms: 'SMS', notification: 'Notification', test: 'Test' };\nconst event = $('Webhook').first().json.body;\n\nif (!event || event.schema_version !== 1 ||\n    typeof event.event_id !== 'string' || !event.event_id ||\n    !Object.hasOwn(messageTypes, event.message_type) ||\n    typeof event.text !== 'string') {\n  throw new Error('Invalid Message487 event');\n}\n\nconst escapeHtml = value => value.replace(/[&<>]/g, character => ({\n  '&': '&amp;', '<': '&lt;', '>': '&gt;',\n})[character]);\nconst firstText = (...values) => values.find(value => typeof value === 'string' && value) || '—';\nconst date = new Date(event.occurred_at);\nconst timestamp = typeof event.occurred_at === 'string' && !Number.isNaN(date.getTime())\n  ? new Intl.DateTimeFormat(locale, {\n    timeZone, day: '2-digit', month: '2-digit', year: 'numeric',\n    hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23',\n  }).format(date).replace(/,/g, '')\n  : '—';\nconst source = firstText(event.sender, event.source_name, event.source);\nconst device = firstText(event.device_code, event.device_id);\nconst segments = [\n  { text: 'Message487: ', bold: false },\n  { text: source, bold: true },\n  { text: '\\n', bold: false },\n  { text: `${messageTypes[event.message_type]}\\n${device}\\n${timestamp}`, bold: true },\n  { text: '\\n', bold: false },\n  { text: typeof event.title === 'string' && event.title ? `${event.title}\\n` : '', bold: false },\n  { text: event.text, bold: false },\n];\n\n// Split unescaped text and close formatting in each part to keep HTML valid.\nconst chunks = [];\nlet html = '';\nlet length = 0;\nfor (const segment of segments) {\n  let run = '';\n  const flush = () => {\n    if (run) {\n      const escaped = escapeHtml(run);\n      html += segment.bold ? `<b>${escaped}</b>` : escaped;\n      run = '';\n    }\n  };\n  for (const character of segment.text) {\n    if (length + character.length > 3500) {\n      flush();\n      chunks.push(html);\n      html = '';\n      length = 0;\n    }\n    run += character;\n    length += character.length;\n  }\n  flush();\n}\nif (html) chunks.push(html);\n\nreturn chunks.map((part, index) => ({\n  json: {\n    telegram_text: chunks.length > 1 ? `[${index + 1}/${chunks.length}]\\n${part}` : part,\n  },\n}));\n"
      }
    },
    {
      "id": "165432a0-b202-5ef0-9fb5-98bb082f060a",
      "name": "Prepare image parts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        0
      ],
      "parameters": {
        "jsCode": "// Standard Telegram nodes send each image separately; no custom node is needed.\nconst result = $input.all();\nconst images = $('Webhook').first().json.body.images ?? [];\nimages.forEach((image, index) => {\n  const kind = ['avatar', 'app_icon'].includes(image.kind) ? image.kind : 'attachment';\n  result.push({ json: {\n    telegram_operation: kind === 'attachment' && ['big_picture', 'gallery'].includes(image.presentation)\n      ? 'sendPhoto' : 'sendDocument',\n    caption: kind === 'avatar' ? 'Avatar' : kind === 'app_icon' ? 'Application icon' : '',\n  }, binary: { data: { data: image.data_base64, mimeType: image.mime_type,\n    fileName: `${kind}-${index + 1}.${image.mime_type === 'image/png' ? 'png' : 'jpg'}` } } });\n});\nreturn result;\n"
      }
    },
